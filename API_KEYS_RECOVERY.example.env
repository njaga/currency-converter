# Kiwango — API key recovery template
# This file contains NO real secrets. Copy the variables you need into .env.local.
# Never commit .env.local.

# ExchangeRate-API
# Historical project provider. The old key was once committed in Git history, so rotate/regenerate it from your provider dashboard before reuse.
EXCHANGE_RATE_API_KEY=replace_with_new_exchange_rate_api_key

# CurrencyAPI
# Historical fallback provider used by the previous project version.
CURRENCY_API_KEY=replace_with_currencyapi_key

# Fawaz Exchange API
# No key required.
FAWAZ_EXCHANGE_API_ENABLED=true

# Frankfurter
# No key required.
FRANKFURTER_ENABLED=true

# REST Countries v5 — destination directory
REST_COUNTRIES_API_KEY=replace_with_rest_countries_key

# Google Maps / Places — nearby ATMs, banks and exchange services
GOOGLE_MAPS_API_KEY=replace_with_restricted_google_places_key

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Affiliate URL templates
AFFILIATE_FLIGHTS_URL_TEMPLATE=
AFFILIATE_HOTELS_URL_TEMPLATE=
AFFILIATE_ESIM_URL_TEMPLATE=
AFFILIATE_ACTIVITIES_URL_TEMPLATE=
AFFILIATE_TRANSFER_URL_TEMPLATE=
AFFILIATE_INSURANCE_URL_TEMPLATE=
AFFILIATE_CAMPAIGN=kiwango
