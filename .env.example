# Public site URL used for canonical URLs and social metadata
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional privacy-first Umami analytics.
# No cookies are required. Kiwango excludes URL search/hash values and respects Do Not Track.
# Example managed/self-hosted script URL: https://analytics.example/script.js
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional comma-separated production domains, e.g. kiwango.app,www.kiwango.app
NEXT_PUBLIC_UMAMI_DOMAINS=

# Optional server-side technical monitoring sink.
# Receives sanitized Kiwango error events only: no IP, coordinates, monetary amounts or user identifiers are included by Kiwango.
MONITORING_WEBHOOK_URL=
MONITORING_WEBHOOK_TOKEN=

# Optional server-side exchange-rate fallbacks. Never expose these with NEXT_PUBLIC_.
# Kiwango tries ExchangeRate-API first, then CurrencyAPI when configured.
EXCHANGE_RATE_API_KEY=
CURRENCY_API_KEY=

# REST Countries API v5 — authenticated source for the global destination directory.
# The app also has a public/provider fallback for resilience.
REST_COUNTRIES_API_KEY=

# Google Maps Platform — server-side Places API (New).
# Restrict this key in Google Cloud to your deployment and only the Places API you use.
GOOGLE_MAPS_API_KEY=

# Affiliate destination URL templates.
# Keep these server-side. Supported placeholders: {countryCode}, {country}, {currency}, {lang}.
# Example: https://partner.example/search?destination={countryCode}&ref=your-id
AFFILIATE_FLIGHTS_URL_TEMPLATE=
AFFILIATE_HOTELS_URL_TEMPLATE=
AFFILIATE_ESIM_URL_TEMPLATE=
AFFILIATE_ACTIVITIES_URL_TEMPLATE=
AFFILIATE_TRANSFER_URL_TEMPLATE=
AFFILIATE_INSURANCE_URL_TEMPLATE=

# Optional campaign tag added by Kiwango to outbound affiliate links when possible.
AFFILIATE_CAMPAIGN=kiwango
