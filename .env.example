# Public site URL used for canonical URLs and social metadata
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional server-side exchange-rate fallback. Never expose this with NEXT_PUBLIC_.
EXCHANGE_RATE_API_KEY=

# Google Maps Platform — server-side Places API (New).
# Restrict this key in Google Cloud to your deployment and only the Places API you use.
GOOGLE_MAPS_API_KEY=

# Affiliate destination URL templates.
# Keep these server-side. Supported placeholders: {countryCode}, {country}, {currency}, {lang}.
# Example: https://partner.example/search?destination={countryCode}&ref=your-id
AFFILIATE_FLIGHTS_URL_TEMPLATE=
AFFILIATE_HOTELS_URL_TEMPLATE=
AFFILIATE_ESIM_URL_TEMPLATE=
AFFILIATE_ACTIVITIES_URL_TEMPLATE=
AFFILIATE_TRANSFER_URL_TEMPLATE=
AFFILIATE_INSURANCE_URL_TEMPLATE=

# Optional campaign tag added by Kiwango to outbound affiliate links when possible.
AFFILIATE_CAMPAIGN=kiwango
